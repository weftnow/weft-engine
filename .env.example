# Local development only. Supply isolated service credentials before enabling matching.
WEFT_ENVIRONMENT=development
WEFT_DOCS_ENABLED=true
WEFT_LOG_LEVEL=INFO
WEFT_MATCHING_DATABASE_URL=
WEFT_CONSOLE_DATABASE_URL=
WEFT_MATCHING_SERVICE_TOKENS={}
WEFT_OPENAI_API_KEY=
WEFT_MATCHING_MAX_SPEND_USD=0
WEFT_MATCHING_INPUT_COST_PER_MILLION_USD=0
WEFT_MATCHING_OUTPUT_COST_PER_MILLION_USD=0
WEFT_MATCHING_EMBEDDING_COST_PER_MILLION_USD=0
WEFT_MATCHING_PROVIDER_CONCURRENCY=4
# F07 automatic matching: off by default. The API process and the worker must agree on this value.
WEFT_MATCHING_AUTOMATIC_ENABLED=false
WEFT_MATCHING_CHANGE_QUIET_SECONDS=30
WEFT_MATCHING_CHANGE_MAX_WAIT_SECONDS=300
WEFT_MATCHING_CHANGE_RETRY_LIMIT=3
WEFT_MATCHING_CHANGE_POLL_LIMIT=500
# Historical experimental settings are ignored by production; candidate reduction is deferred.
WEFT_MATCHING_EXPERIMENTS_ENABLED=false
WEFT_MATCHING_SCREENING_THRESHOLD=60
WEFT_MATCHING_CANDIDATE_SEARCH_MODE=20_40
WEFT_MATCHING_RETRIEVAL_EXPERIMENT_MODE=blended
